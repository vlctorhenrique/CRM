NODE_ENV=development

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:change-this-database-password@localhost:5432/crm

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

API_PORT=3333
API_HOST=0.0.0.0
API_INTERNAL_URL=http://localhost:3333
TRUST_PROXY=false

JWT_SECRET=change-this-to-a-random-string-with-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_DOMAIN=

WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
ENABLE_API_DOCS=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Simulador local de mensagens inbound (nunca habilitar em produção)
ENABLE_DEV_SIMULATOR=false

# Worker de cadências no processo da API
CADENCE_WORKER_ENABLED=true
CADENCE_WORKER_INTERVAL_MS=30000
CADENCE_MAX_ATTEMPTS=3

# IA assistiva: off | fallback | llm
AI_MODE=fallback
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=200
AI_TIMEOUT_MS=15000

SEED_TENANT_NAME=Clinica Aurora
SEED_TENANT_SLUG=clinica-demo
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@clinica.demo
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_USERS=true

# WhatsApp Cloud API
# disabled: não envia e não registra mensagens automáticas
# dry-run: registra envios simulados, ideal para desenvolvimento
# live: integração real, exige verify token, app secret, access token e phone number ID
WHATSAPP_MODE=dry-run
WHATSAPP_VERIFY_TOKEN=change-this-verify-token
WHATSAPP_APP_SECRET=change-this-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER=+55 11 90000-0000
WHATSAPP_INITIAL_MESSAGE=Olá! Que bom ter você aqui. Para eu te ajudar melhor, qual procedimento ou tratamento despertou seu interesse?

NEXT_PUBLIC_SHOW_DEMO_HINTS=true
APP_VERSION=0.1.0

HTTP_PORT=8080
